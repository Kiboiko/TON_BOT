# =============================================================================
# TON Site Builder — переменные для docker compose
# =============================================================================
# Этот файл читает сам docker compose (не backend). Настройки приложения лежат
# отдельно, в backend/.env — см. backend/.env.example.
#
#   cp .env.example .env   и заполните значения.
# =============================================================================

# --- база данных ------------------------------------------------------------
# Пароль обязан совпадать с тем, что стоит в DATABASE_URL в backend/.env.
POSTGRES_USER=ton
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_ДЛИННЫЙ_СЛУЧАЙНЫЙ_ПАРОЛЬ
POSTGRES_DB=ton_builder

# --- адреса в сети TON ------------------------------------------------------
# Оба сервиса объявляют эти адреса в DHT, и по ним к ним обращается вся
# остальная сеть. Значение по умолчанию 0.0.0.0 годится только для локального
# запуска: с ним публикация проходит, но скачать сайт из сети TON невозможно —
# шлюз отвечает «bag has no reachable peers». Подставьте публичный IP сервера.
#
# storage-daemon: раздача опубликованных сайтов (UDP 3333)
STORAGE_ADNL_ADDR=ПУБЛИЧНЫЙ_IP:3333
# ton-site: приём http-запросов из сети TON по ADNL (UDP 3335)
TON_SITE_ADNL_ADDR=ПУБЛИЧНЫЙ_IP:3335

# --- образ с бинарями TON ---------------------------------------------------
# По умолчанию берётся официальный образ. Меняйте, только если собираете свой.
# TON_STORAGE_IMAGE=ghcr.io/ton-blockchain/ton:latest
