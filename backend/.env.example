# =============================================================================
# TON Site Builder — конфигурация backend
# =============================================================================
# Перенос на боевой сервер = замена этого файла, правок в коде быть не должно.
# Для каждого параметра ниже указаны ТЕСТОВОЕ и БОЕВОЕ значения.
#
#   cp .env.example .env   и заполните значения.
# =============================================================================

# --- окружение --------------------------------------------------------------
# тест: dev | бой: prod  (в prod включаются обязательные проверки конфига)
ENV=dev
DEBUG=true
API_PREFIX=/api
# тест: *  | бой: https://app.example.com  (домен Mini App, через запятую)
CORS_ORIGINS=*

# --- база данных ------------------------------------------------------------
# тест: postgresql+asyncpg://ton:ton@localhost:5432/ton_builder
# бой:  postgresql+asyncpg://ton:СИЛЬНЫЙ_ПАРОЛЬ@postgres:5432/ton_builder
DATABASE_URL=postgresql+asyncpg://ton:ton@postgres:5432/ton_builder
DB_ECHO=false

# --- redis и очередь --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# тест: memory (без Redis) | бой: redis
QUEUE_MODE=redis
QUEUE_NAME=ton_builder:jobs

# --- telegram ---------------------------------------------------------------
# тест: токен тестового бота от @BotFather | бой: токен боевого бота
TELEGRAM_BOT_TOKEN=
# https-URL Mini App (кнопка в боте). бой: https://app.example.com
MINI_APP_URL=
TELEGRAM_INITDATA_TTL=86400
# ВНИМАНИЕ: true отключает проверку подписи initData. Только локальная разработка.
# бой: ОБЯЗАТЕЛЬНО false
ALLOW_INSECURE_AUTH=false

# telegram_id администраторов через запятую (получают is_admin при входе)
ADMIN_TELEGRAM_IDS=

# --- TON --------------------------------------------------------------------
# тест: testnet | бой: mainnet
TON_NETWORK=testnet
# тест: https://testnet.toncenter.com/api/v2
# бой:  https://toncenter.com/api/v2
TON_API_BASE=https://testnet.toncenter.com/api/v2
# ключ toncenter (на бою обязателен — без него жёсткий rate limit)
TON_API_KEY=
# Кошелёк проекта: сюда приходят платежи за подписки и премиум-блок.
# тест: адрес тестового кошелька | бой: адрес боевого (лучше мультисиг)
TREASURY_ADDRESS=
# тест: mock (принимать любые платежи) | бой: onchain (реальная проверка)
TON_VERIFY_MODE=onchain
PAYMENT_AMOUNT_TOLERANCE=0.005
TX_CONFIRM_TIMEOUT=180
TX_CONFIRM_INTERVAL=6

# --- TON Connect (ton_proof) ------------------------------------------------
# Домен Mini App: обязан совпадать с доменом в подписи кошелька.
# тест: localhost | бой: app.example.com
TONCONNECT_DOMAIN=localhost
TONPROOF_PAYLOAD_TTL=600
# случайная строка, поменять на бою
TONPROOF_SECRET=change-me

# --- subdom.zone ------------------------------------------------------------
SUBDOM_API_BASE=https://api.subdom.zone
SUBDOM_API_KEY=
SUBDOM_TIMEOUT=20
SUBDOM_RETRIES=3
# тест: fake (встроенная заглушка, работает без сети) | бой: http
SUBDOM_MODE=http

# --- зона субдоменов --------------------------------------------------------
# Платформа владеет одним доменом .ton и разворачивает на нём зону субдоменов;
# пользователи получают адреса имя.домен.ton. Эти же значения правятся в админке.
ZONE_DOMAIN=                  # например mysites.ton
ZONE_DNS_ITEM_ADDRESS=        # адрес NFT этого домена
ZONE_COLLECTION_ADDRESS=      # появляется после разворота зоны
ZONE_MODE=proxy               # proxy | sbt
# Резолвер TON DNS для проверки занятости имени
TON_DNS_API=https://tonapi.io

# --- TON Storage ------------------------------------------------------------
# тест: local (каталог на диске) | бой: daemon (ton-storage-daemon)
# У демона нет HTTP API: backend управляет им через storage-daemon-cli.
# Бинарь уже в образе, ключи демон генерирует сам в общем томе.
TON_STORAGE_MODE=local
# storage-daemon работает в сети хоста (ради UDP), поэтому по имени сервиса
# из контейнера backend он не виден — только через host.docker.internal.
TON_STORAGE_CONTROL=host.docker.internal:5555
TON_STORAGE_CLI=storage-daemon-cli
TON_STORAGE_CLI_KEY=/var/ton-work/db/cli-keys/client
TON_STORAGE_CLI_PUB=/var/ton-work/db/cli-keys/server.pub
# общий том backend-а и storage-daemon
SITES_BUILD_DIR=/data/sites
PUBLIC_SITE_BASE_URL=

# --- подписки ---------------------------------------------------------------
# бесплатная публикация первого сайта, дней
TRIAL_DAYS=7
# за сколько дней предупреждать об окончании подписки
EXPIRING_SOON_DAYS=3
# период прогона планировщика, сек
SCHEDULER_INTERVAL=300

# --- загрузка изображений ---------------------------------------------------
UPLOADS_DIR=/data/uploads
MAX_UPLOAD_BYTES=5242880

# --- лимиты пользовательского контента --------------------------------------
MAX_CONTENT_JSON_BYTES=512000
MAX_CUSTOM_CODE_BYTES=256000

# ADNL-адрес собственного TON-сайта (55 символов). Берётся из лога сервиса
# ton-site при первом старте, см. docs/DEPLOY.md. Пустое значение просто
# отключает кнопку «Включить прямую отдачу».
TON_SITE_ADNL=
