# Базовый URL API. Пусто = тот же origin (nginx проксирует /api на backend).
VITE_API_BASE=

# Манифест TON Connect: должен лежать на https-домене Mini App.
VITE_TONCONNECT_MANIFEST=/tonconnect-manifest.json

# Мок API-контракта (работа без backend).
#   1 — всегда мок, 0 — никогда, не задан — авто:
#   мок включается вне Telegram или когда backend не отвечает.
# VITE_USE_MOCK=

# Прокси для dev-сервера
VITE_API_PROXY=http://localhost:8000
